{
  "name": "stock-digger",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@tanstack/react-query": "^5.102.7",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-haptics": "^57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "^57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "check:screener": "node --experimental-strip-types scripts/check-screener.mjs",
    "check:engine": "cd server && python check_engine.py",
    "check:repository": "cd server && python check_repository.py",
    "check:api": "cd server && python check_api.py",
    "check:market": "cd server && python check_market_data.py",
    "check:chart": "node --experimental-strip-types scripts/check-finance-chart.ts",
    "sync:sec": "cd server && python sync_sec.py",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
